# Socket local + autenticación peer (rol de Postgres = usuario del sistema)
DATABASE_URL=postgresql+psycopg:///tareas_db

# Alternativa con usuario y contraseña por TCP:
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/tareas_db

# Clave para firmar los JWT; generar una con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave
